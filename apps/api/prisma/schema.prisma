  concepto             String
  periodo              String?          @db.Char(7)
  tipoComprobante      TipoComprobante? @map("tipo_comprobante")
  serieNumero          String?          @map("serie_numero")
  fechaEmision         DateTime         @map("fecha_emision") @db.Date
  fechaVencimiento     DateTime         @map("fecha_vencimiento") @db.Date
  monto                Decimal          @db.Decimal(12, 2)
  montoPagado          Decimal          @default(0) @map("monto_pagado") @db.Decimal(12, 2)
  saldo                Decimal          @db.Decimal(12, 2)
  generadoAutomaticamente Boolean       @default(false) @map("generado_automaticamente")
  creadoPorId          String?          @map("creado_por_id") @db.Uuid
  creadoEn             DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn        DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  anuladoEn            DateTime?        @map("anulado_en") @db.Timestamptz(3)
  anuladoPorId         String?          @map("anulado_por_id") @db.Uuid
  motivoAnulacion      String?          @map("motivo_anulacion")

  cliente            Cliente             @relation(fields: [clienteId], references: [id])
  servicioContratado ServicioContratado? @relation(fields: [servicioContratadoId], references: [id])
  creadoPor          Usuario?            @relation("CreadorDeIngreso", fields: [creadoPorId], references: [id])
  anuladoPor         Usuario?            @relation("AnuladorDeIngreso", fields: [anuladoPorId], references: [id])
  cobros             Cobro[]

  @@index([clienteId, fechaVencimiento])
  @@index([fechaVencimiento, saldo])
  @@index([periodo])
  @@map("ingresos")
}

model Cobro {
  id              String    @id @default(uuid()) @db.Uuid
  ingresoId       String    @map("ingreso_id") @db.Uuid
  fecha           DateTime  @db.Date
  importe         Decimal   @db.Decimal(12, 2)
  medioPagoId     String    @map("medio_pago_id") @db.Uuid
  operacion       String?
  voucherId       String?   @map("voucher_id") @db.Uuid
  registradoPorId String    @map("registrado_por_id") @db.Uuid
  registradoEn    DateTime  @default(now()) @map("registrado_en") @db.Timestamptz(3)
  anuladoEn       DateTime? @map("anulado_en") @db.Timestamptz(3)
  anuladoPorId    String?   @map("anulado_por_id") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion")

  ingreso       Ingreso   @relation(fields: [ingresoId], references: [id])
  medioPago     MedioPago @relation(fields: [medioPagoId], references: [id])
  voucher       Archivo?  @relation(fields: [voucherId], references: [id])
  registradoPor Usuario   @relation("RegistradorDeCobro", fields: [registradoPorId], references: [id])
  anuladoPor    Usuario?  @relation("AnuladorDeCobro", fields: [anuladoPorId], references: [id])

  @@index([ingresoId])
  @@index([fecha])
  @@map("cobros")
}

model Egreso {
  id              String           @id @default(uuid()) @db.Uuid
  concepto        String
  proveedorId     String?          @map("proveedor_id") @db.Uuid
  fecha           DateTime         @db.Date
  importe         Decimal          @db.Decimal(12, 2)
  categoriaId     String           @map("categoria_id") @db.Uuid
  tipoComprobante TipoComprobante? @map("tipo_comprobante")
  serieNumero     String?          @map("serie_numero")
  comprobanteId   String?          @map("comprobante_id") @db.Uuid
  responsableId   String           @map("responsable_id") @db.Uuid
  medioPagoId     String           @map("medio_pago_id") @db.Uuid
  clienteId       String?          @map("cliente_id") @db.Uuid
  observaciones   String?
  creadoPorId     String           @map("creado_por_id") @db.Uuid
  creadoEn        DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  anuladoEn       DateTime?        @map("anulado_en") @db.Timestamptz(3)
  anuladoPorId    String?          @map("anulado_por_id") @db.Uuid
  motivoAnulacion String?          @map("motivo_anulacion")

  proveedor   Proveedor?      @relation(fields: [proveedorId], references: [id])
  categoria   CategoriaEgreso @relation(fields: [categoriaId], references: [id])
  comprobante Archivo?        @relation(fields: [comprobanteId], references: [id])
  responsable Usuario         @relation("ResponsableDeEgreso", fields: [responsableId], references: [id])
  medioPago   MedioPago       @relation(fields: [medioPagoId], references: [id])
  cliente     Cliente?        @relation(fields: [clienteId], references: [id])
  creadoPor   Usuario         @relation("CreadorDeEgreso", fields: [creadoPorId], references: [id])
  anuladoPor  Usuario?        @relation("AnuladorDeEgreso", fields: [anuladoPorId], references: [id])

  @@index([fecha])
  @@index([categoriaId])
  @@map("egresos")
}
