datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AlcanceRol {
  GLOBAL
  ASIGNADO
  PROPIO
}

enum AccionAuditoria {
  CREAR
  MODIFICAR
  ACTIVAR
  DESACTIVAR
  INGRESAR
  INGRESO_FALLIDO
  SALIR
  REVOCAR_SESION
  PERMISO_DENEGADO
}

model Usuario {
  id                         String    @id @default(uuid()) @db.Uuid
  nombre                     String
  correo                     String    @unique @db.Citext
  hashContrasena             String    @map("hash_contrasena")
  debeCambiarContrasena      Boolean   @default(false) @map("debe_cambiar_contrasena")
  mfaActivo                  Boolean   @default(false) @map("mfa_activo")
  mfaSecretoCifrado          String?   @map("mfa_secreto_cifrado")
  mfaSecretoPendienteCifrado String?   @map("mfa_secreto_pendiente_cifrado")
  intentosFallidos           Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta             DateTime? @map("bloqueado_hasta") @db.Timestamptz(3)
  activo                     Boolean   @default(true)
  ultimoIngreso              DateTime? @map("ultimo_ingreso") @db.Timestamptz(3)
  creadoEn                   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn              DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  roles                UsuarioRol[]         @relation("RolesDelUsuario")
  rolesAsignados       UsuarioRol[]         @relation("RolesAsignadosPor")
  rolesRetirados       UsuarioRol[]         @relation("RolesRetiradosPor")
  sesiones             Sesion[]             @relation("SesionesDelUsuario")
  sesionesRevocadas    Sesion[]             @relation("SesionesRevocadasPor")
  desafiosMfa          DesafioMfa[]
  codigosRecuperacion  CodigoRecuperacion[]
  registrosAuditoria   Auditoria[]
  trabajador           Trabajador?
  clientesResponsable  Cliente[]            @relation("ResponsableDelCliente")
  clientesCreados      Cliente[]            @relation("CreadorDelCliente")
  asignaciones         AsignacionCliente[]  @relation("AsignacionesDelUsuario")
  asignacionesHechas   AsignacionCliente[]  @relation("AsignacionesHechasPor")
  asignacionesRetiradas AsignacionCliente[] @relation("AsignacionesRetiradasPor")

  @@map("usuarios")
}

model Rol {
  id          String     @id @default(uuid()) @db.Uuid
  codigo      String     @unique
  nombre      String
  descripcion String?
  alcance     AlcanceRol
  exigeMfa    Boolean    @default(false) @map("exige_mfa")
  esSistema   Boolean    @default(false) @map("es_sistema")
  activo      Boolean    @default(true)
  creadoEn    DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  permisos RolPermiso[]
  usuarios UsuarioRol[]

  @@map("roles")
}

model Permiso {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique
  modulo      String
  descripcion String
  sensible    Boolean @default(false)

  roles RolPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  id            String    @id @default(uuid()) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  rolId         String    @map("rol_id") @db.Uuid
  asignadoEn    DateTime  @default(now()) @map("asignado_en") @db.Timestamptz(3)
  asignadoPorId String?   @map("asignado_por_id") @db.Uuid
  retiradoEn    DateTime? @map("retirado_en") @db.Timestamptz(3)
  retiradoPorId String?   @map("retirado_por_id") @db.Uuid

  usuario     Usuario  @relation("RolesDelUsuario", fields: [usuarioId], references: [id])
  rol         Rol      @relation(fields: [rolId], references: [id])
  asignadoPor Usuario? @relation("RolesAsignadosPor", fields: [asignadoPorId], references: [id])
  retiradoPor Usuario? @relation("RolesRetiradosPor", fields: [retiradoPorId], references: [id])

  @@index([usuarioId, retiradoEn])
  @@index([rolId, retiradoEn])
  @@map("usuarios_roles")
}

model RolPermiso {
  id         String    @id @default(uuid()) @db.Uuid
  rolId      String    @map("rol_id") @db.Uuid
  permisoId  String    @map("permiso_id") @db.Uuid
  otorgadoEn DateTime  @default(now()) @map("otorgado_en") @db.Timestamptz(3)
  retiradoEn DateTime? @map("retirado_en") @db.Timestamptz(3)

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@index([rolId, retiradoEn])
  @@map("roles_permisos")
}

model Sesion {
  id               String    @id @default(uuid()) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  hashToken        String    @unique @map("hash_token")
  ip               String?
  agenteUsuario    String?   @map("agente_usuario")
  creadaEn         DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)
  ultimoUso        DateTime  @default(now()) @map("ultimo_uso") @db.Timestamptz(3)
  expiraEn         DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn       DateTime? @map("revocada_en") @db.Timestamptz(3)
  revocadaPorId    String?   @map("revocada_por_id") @db.Uuid
  motivoRevocacion String?   @map("motivo_revocacion")

  usuario     Usuario  @relation("SesionesDelUsuario", fields: [usuarioId], references: [id])
  revocadaPor Usuario? @relation("SesionesRevocadasPor", fields: [revocadaPorId], references: [id])

  @@index([usuarioId, revocadaEn])
  @@map("sesiones")
}

model DesafioMfa {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(3)
  intentos  Int       @default(0)
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("desafios_mfa")
}

model CodigoRecuperacion {
  id           String    @id @default(uuid()) @db.Uuid
  usuarioId    String    @map("usuario_id") @db.Uuid
  hashCodigo   String    @map("hash_codigo")
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  usadoEn      DateTime? @map("usado_en") @db.Timestamptz(3)
  invalidadoEn DateTime? @map("invalidado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, hashCodigo])
  @@map("codigos_recuperacion")
}

model Auditoria {
  id        BigInt          @id @default(autoincrement())
  fecha     DateTime        @default(now()) @db.Timestamptz(3)
  usuarioId String?         @map("usuario_id") @db.Uuid
  sesionId  String?         @map("sesion_id") @db.Uuid
  ip        String?
  accion    AccionAuditoria
  entidad   String
  entidadId String?         @map("entidad_id")
  antes     Json?
  despues   Json?
  motivo    String?

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId, fecha])
  @@index([usuarioId, fecha])
  @@index([fecha])
  @@map("auditoria")
}

enum EstadoTrabajador {
  ACTIVO
  INACTIVO
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum EstadoCliente {
  ACTIVO
  SUSPENDIDO
  INACTIVO
}

enum RolEnCliente {
  RESPONSABLE
  APOYO
  REVISOR
  CONSULTA
}

model Area {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String   @unique @db.Citext
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  trabajadores Trabajador[]

  @@map("areas")
}

model Cargo {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String   @unique @db.Citext
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  trabajadores Trabajador[]

  @@map("cargos")
}

model TipoVinculo {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String   @unique @db.Citext
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  trabajadores Trabajador[]

  @@map("tipos_vinculo")
}

model RegimenTributario {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String   @unique @db.Citext
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  clientes Cliente[]

  @@map("regimenes_tributarios")
}

model Trabajador {
  id                 String           @id @default(uuid()) @db.Uuid
  usuarioId          String           @unique @map("usuario_id") @db.Uuid
  nombres            String
  apellidos          String
  dni                String           @unique @db.Char(8)
  cargoId            String           @map("cargo_id") @db.Uuid
  areaId             String           @map("area_id") @db.Uuid
  tipoVinculoId      String           @map("tipo_vinculo_id") @db.Uuid
  fechaIncorporacion DateTime         @map("fecha_incorporacion") @db.Date
  horario            String?
  telefono           String?
  funciones          String?
  supervisorId       String?          @map("supervisor_id") @db.Uuid
  estado             EstadoTrabajador @default(ACTIVO)
  fechaCese          DateTime?        @map("fecha_cese") @db.Date
  creadoEn           DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn      DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario      Usuario      @relation(fields: [usuarioId], references: [id])
  cargo        Cargo        @relation(fields: [cargoId], references: [id])
  area         Area         @relation(fields: [areaId], references: [id])
  tipoVinculo  TipoVinculo  @relation(fields: [tipoVinculoId], references: [id])
  supervisor   Trabajador?  @relation("Supervision", fields: [supervisorId], references: [id])
  supervisados Trabajador[] @relation("Supervision")

  @@index([estado])
  @@map("trabajadores")
}

model Cliente {
  id                  String        @id @default(uuid()) @db.Uuid
  tipoPersona         TipoPersona   @map("tipo_persona")
  razonSocial         String        @map("razon_social")
  ruc                 String?       @unique @db.Char(11)
  dni                 String?       @unique @db.Char(8)
  domicilioFiscal     String?       @map("domicilio_fiscal")
  representanteLegal  String?       @map("representante_legal")
  actividadEconomica  String?       @map("actividad_economica")
  regimenTributarioId String?       @map("regimen_tributario_id") @db.Uuid
  fechaIncorporacion  DateTime      @map("fecha_incorporacion") @db.Date
  estado              EstadoCliente @default(ACTIVO)
  responsableId       String?       @map("responsable_id") @db.Uuid
  creadoPorId         String?       @map("creado_por_id") @db.Uuid
  creadoEn            DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn       DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  regimenTributario RegimenTributario?  @relation(fields: [regimenTributarioId], references: [id])
  responsable       Usuario?            @relation("ResponsableDelCliente", fields: [responsableId], references: [id])
  creadoPor         Usuario?            @relation("CreadorDelCliente", fields: [creadoPorId], references: [id])
  contactos         ContactoCliente[]
  asignaciones      AsignacionCliente[]

  @@index([estado, razonSocial])
  @@map("clientes")
}

model ContactoCliente {
  id            String   @id @default(uuid()) @db.Uuid
  clienteId     String   @map("cliente_id") @db.Uuid
  nombre        String
  cargo         String?
  correo        String?  @db.Citext
  telefono      String?
  principal     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId, activo])
  @@map("contactos_cliente")
}

model AsignacionCliente {
  id            String       @id @default(uuid()) @db.Uuid
  usuarioId     String       @map("usuario_id") @db.Uuid
  clienteId     String       @map("cliente_id") @db.Uuid
  rolEnCliente  RolEnCliente @map("rol_en_cliente")
  asignadoEn    DateTime     @default(now()) @map("asignado_en") @db.Timestamptz(3)
  asignadoPorId String?      @map("asignado_por_id") @db.Uuid
  retiradoEn    DateTime?    @map("retirado_en") @db.Timestamptz(3)
  retiradoPorId String?      @map("retirado_por_id") @db.Uuid

  usuario     Usuario  @relation("AsignacionesDelUsuario", fields: [usuarioId], references: [id])
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  asignadoPor Usuario? @relation("AsignacionesHechasPor", fields: [asignadoPorId], references: [id])
  retiradoPor Usuario? @relation("AsignacionesRetiradasPor", fields: [retiradoPorId], references: [id])

  @@index([usuarioId, retiradoEn])
  @@index([clienteId, retiradoEn])
  @@map("asignaciones_cliente")
}
